# — Docker Environment Configuration ————————
#
# Copy this file to .env.docker and fill in your actual values.
#
# IMPORTANT: This file uses Docker service names (postgres, redis)
# instead of localhost. Inside Docker, "localhost" means "this
# container only" — not the host machine.

# — Application ————————
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# — CORS ————————
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# — Database ————————
# "postgres" is the Docker service name, NOT localhost.
# These must match the POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB
# values in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://forgeai:forgeai@postgres:5432/forgeai

# — Redis ————————
# "redis" is the Docker service name, NOT localhost.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_MAX_CONNECTIONS=20

# — Authentication ————————
# Generate with: openssl rand -hex 32
# NEVER use this example value in production.
JWT_SECRET_KEY=change-me-to-a-real-secret-in-production

# — OpenAI / LLM ————————
# Your actual API key. Never commit this.
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.7
LLM_PROVIDER=openai

# — OpenRouter / Embeddings ————————
# OPENROUTER_API_KEY=your-openrouter-key-here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
EMBEDDING_DIMENSIONS=1024

# — Document Upload ————————
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# — Rate Limiting ————————
RATE_LIMIT_CHAT_MAX=20
RATE_LIMIT_CHAT_WINDOW=60
RATE_LIMIT_EMBED_MAX=5
RATE_LIMIT_EMBED_WINDOW=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=60